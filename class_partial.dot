calc [label="{OrderCalculator|{MIN_QUANTITY=1\lMAX_QUANTITY=10000\lMIN_PRICE=0.01\lMAX_PRICE=5000000.0\lMIN_DISCOUNT=0.0\lMAX_DISCOUNT=30.0\lVAT_RATE=40.0\l}|+ validateQuantity(int):String\l+ validatePrice(double):String\l+ validateDiscount(double):String\l+ validate(int,double,double):String\l+ isValid(int,double,double):boolean\l+ calculateBase(int,double):double\l+ applyDiscount(double,double):double\l+ calculateVat(double,double):double\l+ calculateTotal(int,double,double,double):double\l}", fillcolor="#FDE9E7", color="#C00000"];

main -> calc [label="uses"];
